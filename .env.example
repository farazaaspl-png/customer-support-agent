# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Supabase Project (ref: rtbeplnzylplpyudrgde)
SUPABASE_URL=https://rtbeplnzylplpyudrgde.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Direct Postgres connection (pooler) — role-based access
# Read-only role: SELECT on customer_support_agent schema
DATABASE_URL_READONLY=postgresql://customer_support_readonly.rtbeplnzylplpyudrgde:YOUR_DB_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
# Agent role: SELECT + limited INSERT/UPDATE (refunds via insert_approved_refund function)
DATABASE_URL=postgresql://customer_support_agent.rtbeplnzylplpyudrgde:YOUR_DB_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# Postgres schema (all app tables live here)
DB_SCHEMA=customer_support_agent

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Frontend (Vite)
VITE_API_URL=http://localhost:8000

# Langfuse (LLM tracing & token usage)
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_ENABLED=true
